        <mxCell id="footnote" parent="1" style="text;html=1;align=left;fontSize=20;fontColor=#64748B;fontFamily=Arial;whiteSpace=wrap;whiteSpace=wrap;" value="All processing modules run in one Java backend deployment with 2+ replicas. HTTP handlers persist jobs; bounded async executors claim them from PostgreSQL.&lt;br&gt;Java applies fixed-role permissions AND business group / region / customer scope to APIs and async jobs. Okta owns role groups; PostgreSQL stores scope bindings and audit.&lt;br&gt;Sending and Open Item completion remain separate." vertex="1">
          <mxGeometry height="120" width="1780" x="55" y="1540.0" as="geometry" />
        </mxCell>
