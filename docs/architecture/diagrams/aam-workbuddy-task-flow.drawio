<mxfile host="app.diagrams.net" agent="AAM architecture authoring" version="24.7.17">
  <diagram id="aam-workbuddy-task-flow" name="Aam Workbuddy Task Flow">
    <mxGraphModel dx="1472" dy="680" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1472" pageHeight="680" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="recognize" value="&lt;b&gt;01  Recognize work&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Mail or chat identifies&lt;br&gt;a customer task&lt;br&gt;AAM intake&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#132B45;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="0" y="55" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="clarify" value="&lt;b&gt;02  Clarify the goal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Robot Card suggests work&lt;br&gt;AM adds context or edits&lt;br&gt;Conversation + UI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#132B45;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="55" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="plan" value="&lt;b&gt;03  Plan the work&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Read authorized sources&lt;br&gt;Choose tools and steps&lt;br&gt;AgentScope + Skills&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=2;fontColor=#132B45;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="55" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="approve" value="&lt;b&gt;04  Approve action&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Review exact content&lt;br&gt;and target recipients&lt;br&gt;AM + Java checks&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontColor=#132B45;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1170" y="55" width="302" height="145" as="geometry" />
        </mxCell>
        <mxCell id="execute" value="&lt;b&gt;05  Execute safely&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:23px&quot;&gt;Call API or MCP tools&lt;br&gt;Save IDs and receipts&lt;br&gt;Business tool adapters&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;fontColor=#132B45;fontFamily=Arial;fontSize=26;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1170" y="435" width="302" height="145" as="geometry" />
        </mxCell>
