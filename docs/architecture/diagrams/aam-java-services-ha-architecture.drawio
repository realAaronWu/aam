<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" version="26.0.0">
  <diagram id="java-ha" name="Java Services and Reliability">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" connect="1" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="AAM — Java Services &amp; High Availability" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=30;fontColor=#334155;">
          <mxGeometry x="50" y="20" width="1600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sub" parent="1" vertex="1" value="Proposed deployment: separate API and Worker services, one shared Java codebase, PostgreSQL-owned business state." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=17;fontColor=#334155;">
          <mxGeometry x="50" y="75" width="1650" height="35" as="geometry" />
        </mxCell>
        <mxCell id="browser" parent="1" vertex="1" value="&lt;b&gt;AM Browser&lt;/b&gt;&lt;br&gt;&lt;br&gt;Local / Regional users" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="480" y="125" width="340" height="75" as="geometry" />
        </mxCell>
        <mxCell id="portal" parent="1" vertex="1" value="&lt;b&gt;Web Portal / BFF&lt;/b&gt;&lt;br&gt;&lt;br&gt;Next.js · 2+ replicas&lt;br&gt;Shared or stateless session handling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#1E3A8A;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="480" y="245" width="340" height="115" as="geometry" />
        </mxCell>
        <mxCell id="okta" parent="1" vertex="1" value="&lt;b&gt;Okta SSO&lt;/b&gt;&lt;br&gt;&lt;br&gt;User authentication and MFA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="70" y="245" width="280" height="115" as="geometry" />
        </mxCell>
        <mxCell id="entra" parent="1" vertex="1" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;br&gt;Graph delegated authorization&lt;br&gt;Azure workload identity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="1410" y="135" width="330" height="125" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" vertex="1" value="&lt;b&gt;01 · Java API Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Spring Boot · 2+ replicas&lt;br&gt;&lt;br&gt;Authorize users and business actions&lt;br&gt;Cases, open items and Playbook publication&lt;br&gt;Commit business changes and durable jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="325" y="465" width="440" height="195" as="geometry" />
        </mxCell>
        <mxCell id="worker" parent="1" vertex="1" value="&lt;b&gt;02 · Java Worker Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Spring Boot + Spring AI · 2+ replicas&lt;br&gt;&lt;br&gt;Synchronize mail and execute durable jobs&lt;br&gt;Generate summaries, replies and Playbooks&lt;br&gt;Leases, retries and fenced result commits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="975" y="465" width="440" height="195" as="geometry" />
        </mxCell>
        <mxCell id="runtime" parent="1" vertex="1" value="Zone-redundant application runtime · Health probes · Replica restart and replacement" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#334155;">
          <mxGeometry x="325" y="400" width="1100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="graph" parent="1" vertex="1" value="&lt;b&gt;Microsoft Graph / Outlook&lt;/b&gt;&lt;br&gt;&lt;br&gt;Approved mailbox synchronization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;fontColor=#164E63;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="975" y="285" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="foundry" parent="1" vertex="1" value="&lt;b&gt;Azure Foundry&lt;/b&gt;&lt;br&gt;&lt;br&gt;Approved AI model deployments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#EA580C;fontColor=#7C2D12;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="1480" y="490" width="270" height="125" as="geometry" />
        </mxCell>
        <mxCell id="pg" parent="1" vertex="1" value="&lt;b&gt;Azure Database for PostgreSQL · HA&lt;/b&gt;&lt;br&gt;&lt;br&gt;Primary + standby · Single write endpoint&lt;br&gt;Business state, durable jobs, cursors and audit&lt;br&gt;Atomic commits · Unique keys · Leases and versions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="630" y="810" width="470" height="150" as="geometry" />
        </mxCell>
        <mxCell id="blob" parent="1" vertex="1" value="&lt;b&gt;Azure Blob Storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;Attachments and example emails&lt;br&gt;Immutable artifacts · ZRS where available" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="1430" y="810" width="320" height="150" as="geometry" />
        </mxCell>
        <mxCell id="monitor" parent="1" vertex="1" value="&lt;b&gt;Azure Monitor / Application Insights&lt;/b&gt;&lt;br&gt;&lt;br&gt;Centralized logs, metrics, traces and alerts&lt;br&gt;Service health, JVM/OOM, backlog, retries and provider failures" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;strokeWidth=2;fontSize=17;fontFamily=Arial;spacing=14;">
          <mxGeometry x="80" y="1000" width="600" height="115" as="geometry" />
        </mxCell>
        <mxCell id="principles" parent="1" vertex="1" value="RELIABILITY CONTRACT&lt;br&gt;&lt;br&gt;At-least-once execution + idempotent business writes&lt;br&gt;No business state held only in JVM memory&lt;br&gt;No synchronous API-to-Worker dependency" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=18;fontColor=#334155;">
          <mxGeometry x="820" y="1000" width="900" height="130" as="geometry" />
        </mxCell>
