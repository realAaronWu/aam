        </mxCell>
        <mxCell id="entra" parent="1" vertex="1" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;&lt;br&gt;Graph mailbox authorization&lt;br&gt;Azure workload identity" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#EDE9FE;strokeColor=#7C3AED;fontColor=#4C1D95;strokeWidth=2;fontFamily=Arial;fontSize=25;spacing=18;align=center;verticalAlign=middle;">
