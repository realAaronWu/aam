        <mxCell id="runtime-label" parent="1" vertex="1" value="Managed runtime | one deployment" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=21;fontColor=#334155;fontStyle=0;">
          <mxGeometry as="geometry" x="650" y="420" width="440" height="35" />
        </mxCell>
        <mxCell id="reliability" parent="1" vertex="1" value="HA and recovery&lt;br&gt;Platform: spread replicas across nodes / zones; health probes, ready-only routing, restart / replacement and graceful rollout.&lt;br&gt;Application: persist jobs before execution; claim across replicas, renew leases and fence stale results.&lt;br&gt;JVM failure: other replicas serve requests and reclaim eligible work. Uncertain sends are reconciled, not blindly retried.&lt;br&gt;Bounded execution protects HTTP latency; replicas share JVM failure scope and scale together." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#334155;fontStyle=0;">
          <mxGeometry as="geometry" x="60" y="1370" width="2100" height="190" />
        </mxCell>
      </root>
