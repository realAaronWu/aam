        <mxCell id="api" parent="1" vertex="1" value="&lt;b&gt;Java Backend Service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Spring Boot + Spring AI | 2+ identical replicas&lt;br&gt;HTTP: sessions, permissions, Cases and approvals&lt;br&gt;Async: mail sync, intent, Playbooks and reply generation&lt;br&gt;Dispatch: AM-approved mail sending and reconciliation&lt;br&gt;Logical modules in one application / JVM per replica" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;strokeWidth=2;fontFamily=Arial;fontSize=25;spacing=18;align=center;verticalAlign=middle;">
          <mxGeometry as="geometry" x="650" y="465" width="840" height="340" />
        </mxCell>
        <mxCell id="isolation" parent="1" vertex="1" value="Execution isolation inside each replica&lt;br&gt;Separate HTTP and bounded async execution pools&lt;br&gt;Limit model / Graph concurrency and DB connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=25;fontColor=#334155;fontStyle=0;">
          <mxGeometry as="geometry" x="675" y="835" width="800" height="135" />
        </mxCell>
        <mxCell id="graph" parent="1" vertex="1" value="&lt;b&gt;Microsoft Graph / Outlook&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mailbox sync and approved sends" style="rounded=1;html=1;whiteSpace=wrap;fillColor=#CFFAFE;strokeColor=#0891B2;fontColor=#164E63;strokeWidth=2;fontFamily=Arial;fontSize=25;spacing=18;align=center;verticalAlign=middle;">
