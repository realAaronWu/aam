        </mxCell>
        <mxCell id="sub" parent="1" vertex="1" value="One Spring Boot application and deployment. Every replica serves HTTP and executes durable background jobs." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=25;fontColor=#334155;fontStyle=0;">
