  <diagram id="java-ha" name="Single Java Backend and HA">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2200" pageHeight="1580" pageScale="1" connect="1" arrows="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="AAM | Single Java Backend and High Availability" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=36;fontColor=#334155;fontStyle=1;">
